sysbus:
    init:
        Tag <0x90000000 0x10000000> "xspi1"
        Tag <0x8010000 0xf0000> "slot0_partition"
        Tag <0x8100000 0xf0000> "slot1_partition"
        Tag <0x8000000 0x10000> "boot_partition"
        Tag <0x81f0000 0x10000> "storage_partition"
        Tag <0x42020000 0x2000> "pinctrl"
        Tag <0x40020000 0x1000> "gpdma1"
        Tag <0x40021000 0x1000> "gpdma2"
        Tag <0x40036400 0x1000> "backup_sram"
        Tag <0x8fff000 0x800> "st_nvm_user_otp"
        Tag <0x8fff800 0x800> "flash@8fff800"
        Tag <0x420c0400 0x800> "hash"
        Tag <0x4000ac00 0x6a0> "fdcan1 / fdcan2"
        Tag <0x40000000 0x400> "timers2"
        Tag <0x40000800 0x400> "timers4"
        Tag <0x40000c00 0x400> "timers5"
        Tag <0x40001000 0x400> "timers6"
        Tag <0x40001400 0x400> "timers7"
        Tag <0x40001800 0x400> "timers12"
        Tag <0x40001c00 0x400> "timers13"
        Tag <0x40002000 0x400> "timers14"
        Tag <0x40002c00 0x400> "wwdg"
        Tag <0x40003800 0x400> "i2s2 / spi2"
        Tag <0x40003c00 0x400> "i2s3 / spi3"
        Tag <0x40004400 0x400> "usart2"
        Tag <0x40004c00 0x400> "uart4"
        Tag <0x40005000 0x400> "uart5"
        Tag <0x40005800 0x400> "i2c2"
        Tag <0x40005c00 0x400> "i3c1"
        Tag <0x40006400 0x400> "usart6"
        Tag <0x40006800 0x400> "usart10"
        Tag <0x40006c00 0x400> "usart11"
        Tag <0x40007800 0x400> "uart7"
        Tag <0x40007c00 0x400> "uart8"
        Tag <0x40008000 0x400> "uart9"
        Tag <0x40008400 0x400> "uart12"
        Tag <0x40008c00 0x400> "digi_die_temp"
        Tag <0x40009400 0x400> "lptim2"
        Tag <0x4000a400 0x400> "fdcan1"
        Tag <0x4000a800 0x400> "fdcan2"
        Tag <0x4000dc00 0x400> "ucpd1"
        Tag <0x40012c00 0x400> "timers1"
        Tag <0x40013000 0x400> "i2s1"
        Tag <0x40013400 0x400> "timers8"
        Tag <0x40013800 0x400> "usart1"
        Tag <0x40014000 0x400> "timers15"
        Tag <0x40014400 0x400> "timers16"
        Tag <0x40014800 0x400> "timers17"
        Tag <0x40014c00 0x400> "spi4"
        Tag <0x40015000 0x400> "spi6"
        Tag <0x40015400 0x400> "sai1 / sai1_a / sai1_b"
        Tag <0x40015800 0x400> "sai2 / sai2_a / sai2_b"
        Tag <0x40016000 0x400> "usb"
        Tag <0x40022000 0x400> "flash"
        Tag <0x40023000 0x400> "crc"
        Tag <0x42028400 0x400> "dac1"
        Tag <0x44002000 0x400> "spi5"
        Tag <0x44002800 0x400> "i2c3"
        Tag <0x44002c00 0x400> "i2c4"
        Tag <0x44003000 0x400> "i3c2"
        Tag <0x44004400 0x400> "lptim1"
        Tag <0x44004800 0x400> "lptim3"
        Tag <0x44004c00 0x400> "lptim4"
        Tag <0x44005000 0x400> "lptim5"
        Tag <0x44005400 0x400> "lptim6"
        Tag <0x44007400 0x400> "vrefbuf"
        Tag <0x44022000 0x400> "exti"
        Tag <0x46008000 0x400> "sdmmc1"
        Tag <0x46008c00 0x400> "sdmmc2"
        Tag <0x47000400 0x400> "fmc"
        Tag <0x47001400 0x400> "xspi1"
        Tag <0x42028000 0x100> "adc1"
        Tag <0x42028100 0x100> "adc2"
        Tag <0xe000ed90 0x40> "mpu"
        Tag <0xe000e010 0x10> "systick"
        Tag <0x10 0x2> "vrefint_otp"
        Tag <0x14 0x2> "ts_cal1_otp"
        Tag <0x18 0x2> "ts_cal2_otp"

timers3: Timers.STM32_Timer @ sysbus <0x40000400, +0x400>
    frequency: 10000000
    initialLimit: 0xffffffff
    ->nvic0@46

gpioa: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>

gpiob: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>

gpioc: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>

gpiod: GPIOPort.STM32_GPIOPort @ sysbus <0x42020c00, +0x400>

gpioe: GPIOPort.STM32_GPIOPort @ sysbus <0x42021000, +0x400>

gpiof: GPIOPort.STM32_GPIOPort @ sysbus <0x42021400, +0x400>

gpiog: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>

gpioh: GPIOPort.STM32_GPIOPort @ sysbus <0x42021c00, +0x400>

gpioi: GPIOPort.STM32_GPIOPort @ sysbus <0x42022000, +0x400>

flash0: Memory.MappedMemory @ sysbus 0x8000000
    size: 0x200000

sram1: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

sram2: Memory.MappedMemory @ sysbus 0x20040000
    size: 0x10000

sram3: Memory.MappedMemory @ sysbus 0x20050000
    size: 0x50000

// autogenerated

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 240000000

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic0

greenled1: Miscellaneous.LED @ gpiob 0x0

gpiob:
    0 -> greenled1@0

yellowled1: Miscellaneous.LED @ gpiof 0x4

gpiof:
    4 -> yellowled1@0

redled1: Miscellaneous.LED @ gpiog 0x4

gpiog:
    4 -> redled1@0

userbutton: Miscellaneous.Button @ gpioc 0xd
    -> gpioc@13

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 32000

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 200000000
    IRQ->nvic0@60

i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    EventInterrupt->nvic0@51
    ErrorInterrupt->nvic0@52

spi1: SPI.STM32H7_SPI @ sysbus 0x40013000
    IRQ->nvic0@55

mac: Network.SynopsysEthernetMAC @ sysbus 0x40028000
    ->nvic0@106

adc12common: Analog.STM32_ADC @ sysbus 0x42028000

rng: Miscellaneous.STM32_RNG @ sysbus 0x420c0800
    series: STM32Series.F4
    ->nvic0@114

lpuart1: UART.STM32F7_USART @ sysbus 0x44002400
    frequency: 200000000
    lowPowerMode: true
    IRQ->nvic0@63

rtc: Timers.STM32F4_RTC @ sysbus 0x44007800
    AlarmIRQ->nvic0@2

pwr: Python.PythonPeripheral @ sysbus 0x44020800
    size: 0x400
    initable: true
    filename: "scripts/pydev/flipflop.py"

rcc: Python.PythonPeripheral @ sysbus 0x44020c00
    size: 0x400
    initable: true
    filename: "scripts/pydev/flipflop.py"

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

// st,stm32h5 overlay

sysbus:
    init add:
        Tag <0x44020814 0x20> "LL_PWR_ACTIVE_VOS" 0xFFFFFFFF

// st,stm32h563 overlay

sysbus:
    init add:
        ApplySVD @https://dl.antmicro.com/projects/renode/svd/STM32H563.svd.gz
        Tag <0x44020824 4> "PWR_DBPCR" 0xFFFFFFFF
        Tag <0x40030404 4> "ICACHE_SR_IDLE" 0x0
